# campus-agent 配置模板
# 复制成 .env 后按注释填写。.env 已被 gitignore，不会进仓库。
# 原则：必填项不给默认值——缺了就启动失败，而不是静默连到别人的库上。

# ===== CampusHub MySQL（只读）=====
# 除了 MYSQL_DB_AGENT 以外都是只读，agent 不写业务表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB_ACTIVITY=campushub_activity
MYSQL_DB_COMMUNITY=campushub_community
MYSQL_DB_SECONDHAND=campushub_secondhand
# Agent 自己的库：聊天记录、checkpointer、配额
MYSQL_DB_AGENT=campushub_agent

# ===== 对话模型（GLM，OpenAI 兼容协议）=====
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
# 必须是文本模型；带 4v 的是视觉模型，不支持 function calling
GLM_CHAT_MODEL=glm-5.3-flash
GLM_VISION_MODEL=glm-4.6v

# ===== Embedding（腾讯 TokenHub，1024 维）=====
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_MODEL_NAME=kinfra-text-embedding-0.6b
TENCENT_TOKENHUB_BASE_URL=

# ===== 联网搜索（只在「随便聊聊」档位使用）=====
TAVILY_API_KEY=

# ===== 阿里云 OSS（附件上传 + 给 MinerU 下载）=====
# 注意：bucket 必须让 MinerU 能从公网读到，否则文档解析会 403。
# 建议 ACL 设为「公共读」，不要用「公共读写」。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing

# ===== MinerU 云端文档解析（PDF / Word → markdown）=====
# 不填则上传照常成功，只是不做解析（对话时读不到文档正文）
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net
# pipeline 更快更便宜；vlm 对复杂版式更准但更慢
MINERU_MODEL=pipeline
MINERU_TIMEOUT=180

# ===== 鉴权 =====
# 必须与 campus-hub 的 campus.jwt.secret 完全一致，否则验不出 userId（全部 401）。
# 上面的占位值是公开的，上线前务必换成真实随机串（32 字节以上）。
JWT_SECRET=change-me-to-a-real-random-secret-at-least-32-bytes

# ===== 配额 =====
DAILY_TOKEN_QUOTA=100000
DAILY_UPLOAD_LIMIT=5

# ===== 附件向量库（Milvus Lite，进程内、落本地文件）=====
# 不需要任何服务端。留空则用 <项目根>/data/rag/milvus.db。
# Docker 部署时建议指向挂载卷，否则容器重建会丢附件索引。
MILVUS_LITE_PATH=/app/data/rag/milvus.db

# ===== 消息队列（可选）=====
# 配了才会启动索引消费者；不配就只能手动跑 ingest 更新索引
RABBITMQ_URL=
RABBITMQ_INDEX_QUEUE=campus.index.rebuild

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
# 逗号分隔；生产环境请写死前端域名，不要用 *
CORS_ALLOW_ORIGINS=*
